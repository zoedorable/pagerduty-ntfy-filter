# Settings for pd_filter.py (KEY=value, one per line).
# Copy to config.env and fill in. Environment variables take precedence.

# Personal PagerDuty API key (My Profile -> User Settings -> API Access)
PD_API_TOKEN=YOUR_PAGERDUTY_API_KEY

# Only needed for account API keys (for the Ack button): your PagerDuty email
PD_FROM_EMAIL=

# Optional: only poll these PagerDuty services (IDs, comma-separated)
PD_SERVICE_IDS=

# Your ntfy topic (pick a hard-to-guess name and subscribe to it in the ntfy app)
NTFY_TOPIC=YOUR_SECRET_TOPIC
# Optional: separate topic for silent notifications (empty = same topic)
NTFY_TOPIC_SILENT=
# Optional: own ntfy server
NTFY_SERVER=https://ntfy.sh

# Loud only if the service name contains this text (empty = all services)
# Separate multiple with ;  e.g. CSOC (High);Other Service
SERVICE_FILTER=CSOC (High)

# Silent notification (no sound) for:
#   customers = your customers, if the service doesn't match
#   all       = all incidents that aren't loud
#   none      = loud alarms only
SILENT_FOR=customers

# How often PagerDuty is polled (seconds)
POLL_SECONDS=30

# Optional: only active during working hours (pauses outside, but keeps running)
ONLY_IN_WINDOW=false
START_HOUR=8
END_HOUR=18
WEEKDAYS_ONLY=true

# Optional: only active while you're on call in a PagerDuty schedule
ONLY_ON_CALL=false
# PagerDuty user (name or email) for the "Hand off on-call" button
OVERRIDE_USER=CSOC Dummy

# LAS (Last Analyst Standing): a button in the dashboard turns on PagerDuty push
# notifications until this hour, then the filter removes them again
LAS_END_HOUR=18
# Which PagerDuty contacts LAS / "On (no end)" turns on (IDs, comma-separated, easiest to pick
# in the dashboard under Settings). Empty = all devices with the PagerDuty app
LAS_CONTACTS=
# For which urgency: high | low | both
LAS_URGENCY=high

# Dashboard in the browser (this machine only). Not 8787, wrangler runs there.
WEB_PORT=8790
