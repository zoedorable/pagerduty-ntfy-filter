{
  "manifest_version": 3,
  "name": "PD-Filter",
  "version": "1.1",
  "description": "Compact view of the local PagerDuty filter; the icon blinks on loud alarms for your customers.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "PD-Filter", "default_icon": { "16": "icon16.png", "48": "icon48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms"],
  "host_permissions": ["http://localhost:8790/*"]
}
